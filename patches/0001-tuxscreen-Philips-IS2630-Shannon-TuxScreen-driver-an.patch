+// license:BSD-3-Clause
+// copyright-holders:ajfa
+/***************************************************************************
+
+    Philips IS2630 "Shannon" screen phone (TuxScreen)
+
+    SA-1100 at 191.7 MHz, 16 MB DRAM on a SODIMM, 4 MB of AMD flash (two x16
+    parts on a 32-bit bus), UCB1200 codec (touchscreen, audio, telecom),
+    640x480 dual-scan colour STN, IR keyboard, two PCMCIA slots, and a
+    DSP1653 modem DSP on a bit-banged SPI bus.
+
+    The unit shipped with Inferno; this driver boots the blob boot loader
+    that the TuxScreen project put in its place.
+
+***************************************************************************/
+
+#include "emu.h"
