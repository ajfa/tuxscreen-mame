@@ -137,6 +157,21 @@ void ucb1200_device::adc_begin_conversion()
 	case ADC_INPUT_TSMX:
 	case ADC_INPUT_TSPY:
 	case ADC_INPUT_TSMY:
+	{
+		uint16_t value = 0;
+		if (m_touch_down)
+		{
+			const uint16_t mode = (m_touch_ctrl & TSC_MODE_MASK) >> TSC_MODE_BIT;
+			if (mode == 1)
+				value = m_touch_p;
+			else if (mode >= 2 && BIT(m_touch_ctrl, TSPX_POW_BIT))
+				value = m_touch_x;
+			else if (mode >= 2 && BIT(m_touch_ctrl, TSPY_POW_BIT))
+				value = m_touch_y;
+		}
+		m_adc_data = (value << ADC_DATA_BIT) & ADC_DATA_MASK;
+		break;
+	}
 	default:
 		m_adc_data = 0;
 		break;
@@ -151,6 +186,14 @@ void ucb1200_device::adc_begin_conversion()
 	}
 
 	m_adc_data |= (1 << ADC_DAT_VAL_BIT);
+
+	if (BIT(m_rising_int_en, ADC_INT_BIT) || BIT(m_falling_int_en, ADC_INT_BIT))
+	{
+		const bool old_irq = (m_int_status != 0);
+		m_int_status |= 1 << ADC_INT_BIT;
+		if (!old_irq)
+			m_irq_out(1);
+	}
