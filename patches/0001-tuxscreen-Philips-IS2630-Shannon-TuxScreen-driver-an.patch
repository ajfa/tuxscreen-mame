 {
+	icp_uart_update_irq();
 }
 
 void sa1110_periphs_device::icp_uart_set_transmit_irq_enabled(bool enabled)
@@ -398,7 +428,17 @@ void sa1110_periphs_device::icp_uart_set_transmit_irq_enabled(bool enabled)
 
 u8 sa1110_periphs_device::icp_uart_read_receive_fifo()
 {
-	return 0;
+	uart_regs &uart = m_icp_regs.uart;
+	const u8 data = uart.rx_fifo[uart.rx_fifo_read_idx];
+	if (uart.rx_fifo_count)
+	{
+		uart.rx_fifo_read_idx = (uart.rx_fifo_read_idx + 1) % std::size(uart.rx_fifo);
+		uart.rx_fifo_count--;
+	}
+	if (!uart.rx_fifo_count)
+		uart.utsr1 &= ~(1 << UTSR1_RNE_BIT);
+	icp_uart_update_irq();
+	return data;
 }
 
