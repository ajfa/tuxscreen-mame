+void sa1110_periphs_device::icp_uart_rx(u8 data)
+{
+	uart_regs &uart = m_icp_regs.uart;
+	if (!BIT(uart.utcr[3], UTCR3_RXE_BIT) || uart.rx_fifo_count >= std::size(uart.rx_fifo))
+		return;
+	uart.rx_fifo[uart.rx_fifo_write_idx] = data;
+	uart.rx_fifo_write_idx = (uart.rx_fifo_write_idx + 1) % std::size(uart.rx_fifo);
+	uart.rx_fifo_count++;
+	uart.utsr1 |= (1 << UTSR1_RNE_BIT);
+	uart.utsr0 |= (1 << UTSR0_RID_BIT);
+	icp_uart_update_irq();
+}
+
+void sa1110_periphs_device::icp_uart_update_irq()
+{
+	const uart_regs &uart = m_icp_regs.uart;
+	const bool pending = BIT(uart.utsr0, UTSR0_RID_BIT) || uart.rx_fifo_count > 4;
+	set_irq_line(INT_UART2, (pending && BIT(uart.utcr[3], UTCR3_RIE_BIT)) ? 1 : 0);
+}
+
 void sa1110_periphs_device::icp_uart_set_receiver_enabled(bool enabled)
 {
+	if (!enabled)
+	{
+		m_icp_regs.uart.rx_fifo_count = 0;
+		m_icp_regs.uart.rx_fifo_read_idx = 0;
+		m_icp_regs.uart.rx_fifo_write_idx = 0;
+		m_icp_regs.uart.utsr1 &= ~(1 << UTSR1_RNE_BIT);
+		m_icp_regs.uart.utsr0 &= ~(1 << UTSR0_RID_BIT);
+	}
+	icp_uart_update_irq();
 }
 
