+void ucb1200_device::touch_w(bool down, uint16_t x, uint16_t y, uint16_t pressure)
+{
+	m_touch_x = x;
+	m_touch_y = y;
+	m_touch_p = pressure;
+	if (down == m_touch_down)
+		return;
+	m_touch_down = down;
+
+	const bool old_irq = (m_int_status != 0);
+	const uint16_t enables = down ? m_falling_int_en : m_rising_int_en;
+	m_int_status |= enables & ((1 << TSPX_INT_BIT) | (1 << TSMX_INT_BIT));
+	if (!old_irq && m_int_status != 0)
+		m_irq_out(1);
+}
